{
  "project": "AI_PR_REVIEWER",
  "project_name": "AI_PR_REVIEWER",
  "reviewType": "git-pr",
  "defaultModel": "local/qwen2.5-coder:32b",
  "readOnly": true,
  "requireHumanMerge": true,
  "maxReviewCostUsd": 2,
  "repo": "duongpdddic-droid/AI_PR_REVIEWER",
  "targetRepos": [
    "duongpdddic-droid/QLDA_DTXD"
  ],
  "maxReviewRounds": 3,
  "notifyTelegram": true,
  "worktree": "pr-reviewer-worktrees/",
  "coderWorkspace": "coder-workspace",
  "reviewerWorkspace": "reviewer-workspace",
  "labels": {
    "queued": "status:queued",
    "review_requested": "status:review-requested",
    "review_in_progress": "status:in-progress",
    "reviewing": "status:reviewing",
    "changes_requested": "status:changes-requested",
    "approved": "status:approved",
    "ready_to_code": "status:ready-for-cline",
    "blocked": "status:blocked"
  },
  "reviewPolicyFile": ".github/ai-review-policy.json",
  "finalReviewer": "agent:gpt",
  "preReviewer": "reviewer:local",
  "findingsFile": "review-state.json",
  "promptsDir": "reviewer-agent/prompts",
  "orchestrator": "scripts/unified-orchestrator.mjs"
}