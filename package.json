{
  "name": "ai-pr-reviewer",
  "version": "1.0.0",
  "description": "Khung orchestration d'agent AI PR Reviewer (Cline rules, Memory Bank, verify, Git Handoff).",
  "type": "module",
  "scripts": {
    "test": "node scripts/test-pure-logic.mjs && node scripts/test-dod.mjs && node scripts/test-circuit-breaker.mjs && node scripts/test-execution-broker.mjs",
    "test:integration": "node scripts/test-integration-orchestrator.mjs && node scripts/test-integration-approval-gate.mjs && node scripts/test-integration-review-runtime.mjs",
    "test:policy": "node scripts/test-effective-policy.mjs && node scripts/test-review-phases.mjs",
    "test:context": "node scripts/test-context-routing.mjs",
    "test:tg": "node scripts/test-tg-notify.mjs",
    "test:gateway": "node scripts/test-telegram-gateway.mjs",
    "test:gateway:mp": "node scripts/telegram-gateway/test-gateway-mp.mjs",
    "gateway": "node scripts/telegram-gateway/gateway.mjs",
    "gateway:supervise": "node scripts/telegram-gateway/supervisor.mjs",
    "gateway:install": "node scripts/telegram-gateway/install.mjs",
    "test:drift": "node scripts/test-protocol-drift.mjs",
    "verify": "node scripts/full-verify.mjs && node scripts/test-evidence-e2e.mjs",
    "test:baseline": "node scripts/extract-behavior-map.mjs && cp scripts/behavior-map-current.json scripts/behavior-map-baseline.json",
    "test:mcp": "node mcp-task-server/test-server.mjs",
    "test:evidence": "node scripts/test-test-evidence.mjs && node scripts/test-evidence-e2e.mjs",
    "test:evidence:mcp": "node mcp-test-evidence/test-server.mjs",
    "test:temp-hygiene": "node scripts/test-temp-hygiene.mjs",
    "map": "node scripts/extract-behavior-map.mjs",
    "intake": "node scripts/github-task-intake.mjs",
    "orchestrate": "node scripts/unified-orchestrator.mjs",
    "autonomous": "node scripts/autonomous-run.mjs",
    "autonomous:execute": "node scripts/autonomous-run.mjs --execute",
    "notify": "node scripts/notify-telegram.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.20.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "acorn": "^8.12.0",
    "acorn-walk": "^8.3.0",
    "jsdom": "^24.0.0"
  }
}
