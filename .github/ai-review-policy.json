{
  "policyVersion": "2026-08-22.1",
  "description": "Policy canonical cho quy trinh AI PR Review (Issue #2). Tai lieu nguoi doc (AGENT_HANDOFF_PROTOCOL.md, AGENTS.md, .clinerules) PHAI tham chieu file nay, khong tu dinh nghia ban thu hai.",
  "scope": {
    "appliesTo": ["duongpdddic-droid/AI_PR_REVIEWER", "duongpdddic-droid/QLDA_DTXD"],
    "note": "Moi repo giu ban sao giong nhau cua file nay; policyVersion phai khop giua hai repo."
  },
  "requiredChecks": [
    "verify"
  ],
  "blockingSeverities": [
    "critical",
    "high"
  ],
  "finalReviewer": "agent:gpt",
  "preReviewer": "reviewer:local",
  "executor": "agent:cline",
  "maxReviewRounds": 3,
  "diffLimits": {
    "maxLines": 1500
  },
  "authority": {
    "ciVerification": "AI_PR_REVIEWER local",
    "semanticPreReview": "reviewer:local",
    "finalApproval": "agent:gpt",
    "merge": "user",
    "deploy": "user"
  },
  "lateEventBehavior": {
    "staleByHeadSha": true,
    "closedPrMutation": "forbidden",
    "postMergeDefect": "regression-issue + new branch/PR"
  },
  "approvalMarker": {
    "format": "html-comment-json",
    "prefix": "<!-- ai-review-approval:",
    "requiredFields": [
      "repository",
      "prNumber",
      "reviewer",
      "headSha",
      "policyVersion",
      "ciEvidence",
      "openBlockingFindings",
      "reviewedAt"
    ],
    "shaLock": "full-40-hex-head-sha",
    "invalidationOnHeadChange": true
  },
  "stateMachine": [
    "status:queued",
    "status:ready-for-cline",
    "status:in-progress",
    "status:review-requested",
    "status:reviewing",
    "status:changes-requested",
    "status:approved",
    "status:blocked"
  ],
  "rules": {
    "ciPassNeverApproves": true,
    "emptyChecksFailClosed": true,
    "singleStatusLabel": true,
    "noReviewFixIssues": true,
    "preReviewVerdictsOnly": ["PRE_REVIEW_PASS", "PRE_REVIEW_FINDINGS"]
  }
}
